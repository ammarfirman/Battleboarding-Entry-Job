# Normalize text to LF in the repo, checkout native on Windows
* text=auto

*.html   text
*.css    text
*.js     text
*.json   text
*.md     text

# Binary assets: never touch line endings, never try to diff
*.woff2  binary
*.mp3    binary
*.gif    binary
*.webp   binary
*.png    binary
*.jpg    binary
*.apk    binary
*.zip    binary

# Generated / vendored: keep out of diffs and GitHub language stats
dist/battleboarding-standalone.html  -text  -diff  linguist-generated=true
www/vendor/**                        linguist-vendored=true
package-lock.json                    -diff  linguist-generated=true
