# ---------------------------------------------------------------------------
# Battleboarding Entry: what git ignores
# ---------------------------------------------------------------------------

# Node
node_modules/

# Capacitor native project. Recreate with: npx cap add android
/android/

# Local JDK drops used only for the Gradle build (see docs/android.md)
/jdk-*/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------

# dist/ holds release artifacts. Only the committed standalone build is
# tracked; everything else here is produced by a build and stays local.
dist/*
!dist/battleboarding-standalone.html

# Compiled installers
*.apk
*.aab

# Electron desktop bundle: ~385 MB of bundled Chromium, regenerated from
# windows-app/ + www/ (see docs/windows.md). Never committed.
windows-app/BattleboardingEntry/
windows-app/BattleboardingEntry.html

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/
